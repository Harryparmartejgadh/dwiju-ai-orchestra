{
  "rules": {
    "users": {
      "$uid": {
        "deviceStatus": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "healthRecords": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        },
        "deviceTelemetry": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        },
        "deviceCommands": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    }
  }
}
